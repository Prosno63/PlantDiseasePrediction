            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"01710000012\",\n  \"password\": \"password123\",\n  \"name\": \"User Name\",\n  \"role\": \"FARMER\",\n  \"profileImageUrl\": null,\n  \"designation\": null,\n  \"qualification\": null,\n  \"specialization\": null,\n  \"available\": true,\n  \"online\": false\n}",
