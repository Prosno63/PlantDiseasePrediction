        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Refresh succeeded', function () { pm.response.to.have.status(200); });", "pm.collectionVariables.set('token', pm.response.json().accessToken);", "pm.collectionVariables.set('refreshToken', pm.response.json().refreshToken);"] }
          }],
          "response": []
