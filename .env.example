# Copy this file to .env and replace every placeholder before deployment.
# Keep .env outside source control.
DB_URL=db_url
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password
DDL_AUTO=validate

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AI_SERVICE_BASE_URL=replace-with-lost-url
AI_SERVICE_API_KEY=replace-with-api-key

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Use a persistent mounted directory or object-storage integration in production.
